# ── Copy to .env on the server:  cp .env.cloud.example .env && chmod 600 .env ──

# Mode: paper first. For live: FX_MODE=live, TRADING_MODE=live, IB_PORT=4003, I_UNDERSTAND_LIVE_TRADING=yes
FX_MODE=paper
TRADING_MODE=paper
IB_PORT=4004
I_UNDERSTAND_LIVE_TRADING=no

# IBKR login used by the headless gateway.
# Paper: your PAPER username/password (Client Portal → Settings → Paper Trading Account).
# Live (later): a SECOND username dedicated to the bot, so it doesn't fight your TWS/phone session.
TWS_USERID=
TWS_PASSWORD=
IB_ACCOUNT=
IB_AUTO_RESTART_TIME=05:05 PM
VNC_SERVER_PASSWORD=

# Cloudflare tunnel token (Zero Trust → Networks → Tunnels → your tunnel → token)
CF_TUNNEL_TOKEN=

# App secrets
TYPESAFE_API_KEY=
DASHBOARD_TOKEN=
TV_WEBHOOK_SECRET=
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
