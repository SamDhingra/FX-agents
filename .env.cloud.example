# ── Copy to .env on the server:  cp .env.cloud.example .env && chmod 600 .env ──

# Mode: paper first. For live: FX_MODE=live, I_UNDERSTAND_LIVE_TRADING=yes
FX_MODE=paper
I_UNDERSTAND_LIVE_TRADING=no

# Broker: oanda (default) or ibkr
FX_BROKER=oanda

# OANDA — practice token for paper (OANDA hub → Manage API Access). A practice token only
# works on the practice server; a live token only on live.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=

# ── IBKR only (leave blank with OANDA). To use IBKR set FX_BROKER=ibkr and COMPOSE_PROFILES=ibkr ──
# Paper: your PAPER username/password (Client Portal → Settings → Paper Trading Account).
# Live: a SECOND username dedicated to the bot, so it doesn't fight your TWS/phone session.
COMPOSE_PROFILES=
TRADING_MODE=paper
IB_PORT=4004
TWS_USERID=
TWS_PASSWORD=
IB_ACCOUNT=
IB_AUTO_RESTART_TIME=05:05 PM
VNC_SERVER_PASSWORD=

# Cloudflare tunnel token (Zero Trust → Networks → Tunnels → your tunnel → token)
CF_TUNNEL_TOKEN=

# App secrets
TYPESAFE_API_KEY=
DASHBOARD_TOKEN=
TV_WEBHOOK_SECRET=
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
