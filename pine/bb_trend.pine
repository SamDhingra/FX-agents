//@version=5
// FX-Agents · Bollinger trend continuation (the posted NQ rules, as fxagents/bb_trend.py tests them)
// Run on a 1-MINUTE chart. Bands come from the last CLOSED 5m / 15m / 1h candle, so nothing repaints.
//  • 1m close above ≥2 of the 3 upper bands → long; below ≥2 of the 3 lower bands → short
//  • stop at the 5m basis (fixed at entry), target 1R · entries 08:00–12:00 New York · 10-bar cooldown after every exit
//  • anything still open at 15:50 New York is closed
// Set your broker's spread under Properties → Slippage / Commission for honest numbers.
strategy("FX-Agents · BB trend continuation", overlay=true, initial_capital=100000,
     default_qty_type=strategy.fixed, default_qty_value=1, process_orders_on_close=true,
     calc_on_every_tick=false, margin_long=0, margin_short=0)

bbLen   = input.int(20, "BB length")
bbMult  = input.float(2.0, "BB multiplier")
need    = input.int(2, "Bands needed (of 3)", minval=1, maxval=3)
rr      = input.float(1.0, "Target (R)", step=0.25)
trailBasis = input.bool(false, "Stop follows the 5m basis (other reading of the rule)")
cool    = input.int(10, "Cooldown bars after an exit")
win     = input.session("0800-1200", "Entry window (New York)")
flatHm  = input.int(1550, "Flatten at (HHMM, New York)")

// last CLOSED higher-timeframe candle: value of [1] with lookahead_on = no repainting
htf(tf, src) => request.security(syminfo.tickerid, tf, src[1], lookahead=barmerge.lookahead_on)
m5  = htf("5",  ta.sma(close, bbLen))
s5  = htf("5",  ta.stdev(close, bbLen))
m15 = htf("15", ta.sma(close, bbLen))
s15 = htf("15", ta.stdev(close, bbLen))
m60 = htf("60", ta.sma(close, bbLen))
s60 = htf("60", ta.stdev(close, bbLen))
u5  = m5 + bbMult * s5
l5  = m5 - bbMult * s5
u15 = m15 + bbMult * s15
l15 = m15 - bbMult * s15
u60 = m60 + bbMult * s60
l60 = m60 - bbMult * s60

ups = (close > u5 ? 1 : 0) + (close > u15 ? 1 : 0) + (close > u60 ? 1 : 0)
dns = (close < l5 ? 1 : 0) + (close < l15 ? 1 : 0) + (close < l60 ? 1 : 0)

nyHm  = hour(time, "America/New_York") * 100 + minute(time, "America/New_York")
inWin = not na(time(timeframe.period, win, "America/New_York"))

var int lastExitBar = na
if strategy.closedtrades > strategy.closedtrades[1]
    lastExitBar := bar_index
cooling = not na(lastExitBar) and bar_index - lastExitBar <= cool

var float stopPx = na
var float tgtPx = na
flat = strategy.position_size == 0
if flat and inWin and not cooling and not na(m5)
    if ups >= need and close > m5
        stopPx := m5
        tgtPx := close + rr * (close - m5)
        strategy.entry("L", strategy.long)
    else if dns >= need and close < m5
        stopPx := m5
        tgtPx := close - rr * (m5 - close)
        strategy.entry("S", strategy.short)

if trailBasis and strategy.position_size > 0 and m5 > stopPx
    stopPx := m5
if trailBasis and strategy.position_size < 0 and m5 < stopPx
    stopPx := m5
strategy.exit("XL", "L", stop=stopPx, limit=tgtPx)
strategy.exit("XS", "S", stop=stopPx, limit=tgtPx)
if nyHm >= flatHm and nyHm < 1700
    strategy.close_all("15:50 flatten")

plot(u5, "5m upper", color.new(color.teal, 40))
plot(m5, "5m basis", color.new(color.gray, 20))
plot(l5, "5m lower", color.new(color.teal, 40))
plot(u15, "15m upper", color.new(color.orange, 60))
plot(l15, "15m lower", color.new(color.orange, 60))
plot(u60, "1h upper", color.new(color.purple, 60))
plot(l60, "1h lower", color.new(color.purple, 60))
