# ~/fx-live/.env.live — secrets of the LIVE site. chmod 600. Never commit, never paste anywhere.
OANDA_API_TOKEN=            # your LIVE account's API token (OANDA → Manage API Access)
OANDA_ACCOUNT_ID=           # e.g. 001-001-1234567-001
OANDA_ENVIRONMENT=live
FX_MODE=live
I_UNDERSTAND_LIVE_TRADING=yes
LIVE_VAULT_KEY=             # filled by ./fx.sh live setup (encrypts members' keys and authenticator secrets)
TELEGRAM_BOT_TOKEN=         # optional: alerts (can be the same bot as practice)
TELEGRAM_CHAT_ID=
NTFY_TOPIC=
ANTHROPIC_API_KEY=          # optional: Ask / reviews, as on practice
